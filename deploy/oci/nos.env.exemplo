# Implantação de dois nós do Urna Velox em servidores Arm da OCI (docs/HANDOFF_IMPLANTACAO_OCI.md).
# Copie para deploy/oci/nos.env, preencha e rode os scripts a partir do WSL/Linux:  cd deploy/oci && ./10_implantar.sh
# Nada aqui é segredo; a chave SSH fica onde você indicar em SSH_CHAVE. (nos.env está no .gitignore.)

# ------------------------------------------------------------------ acesso
# Transporte: "ssh" (padrão, usa ssh/scp na porta 22) ou "oci" (usa OCI CLI Run Command + Object Storage por HTTPS 443,
# para redes corporativas onde a porta 22 de saída é bloqueada; ver docs/HANDOFF_DEPLOY_SEM_SSH.md).
TRANSPORTE=ssh
SSH_USUARIO=ubuntu                       # usuário padrão da imagem Ubuntu da OCI (usado quando TRANSPORTE=ssh)
SSH_CHAVE=~/.ssh/oci_urna_velox          # chave privada usada ao criar as instâncias (usado quando TRANSPORTE=ssh)
OCI_COMPARTIMENTO=ocid1.tenancy.oc1..xxx # OCID do compartimento/tenancy (usado por 00_criar_oci.sh e TRANSPORTE=oci)
OCI_BUCKET=urna-velox-implantacao        # bucket privado do Object Storage para transferência de arquivos (TRANSPORTE=oci)
OCI_NAMESPACE=                           # namespace do Object Storage (vazio = descoberto automaticamente via oci os ns get)

# ------------------------------------------------------------------ nó A
NO_A_ID=no-a                              # id estável (entra no hash da partição: não mude durante uma eleição)
NO_A_ORGAO="Órgão A"                      # quem opera o servidor (o limite do TSE é por órgão)
NO_A_OCID=ocid1.instance.oc1.sa-saopaulo-1.xxx # OCID da instância na OCI (obrigatório quando TRANSPORTE=oci)
NO_A_IP_PUBLICO=203.0.113.10              # IP público RESERVADO da instância = IP de saída que a CDN do TSE vê
NO_A_IP_PRIVADO=10.0.1.10                 # IP privado na VCN (sincronização entre os nós)
NO_A_COLETA=true                          # true = coleta do TSE

# ------------------------------------------------------------------ nó B
NO_B_ID=no-b
NO_B_ORGAO="Órgão B"                      # MESMO órgão do A?  então NO_B_COLETA=false (só recebe e totaliza)
NO_B_OCID=ocid1.instance.oc1.sa-saopaulo-1.yyy # OCID da instância na OCI (obrigatório quando TRANSPORTE=oci)
NO_B_IP_PUBLICO=203.0.113.11
NO_B_IP_PRIVADO=10.0.1.11
NO_B_COLETA=true

# ------------------------------------------------------------------ federação
# Endereço de sincronização: "privado" (os dois na mesma VCN, porta fechada para a internet) ou "publico"
# (VCNs/regiões/contas diferentes; a porta abre só para o IP público do outro nó).
FED_REDE=privado
FED_PORTA=7700
ECO_IP=https://checkip.amazonaws.com      # devolve o IP de saída (texto); o nó só coleta se for o NO_x_IP_PUBLICO

# ------------------------------------------------------------------ eleição
PLEITO=3221                               # 3221 = 2º turno de 2026
CICLO=ele2026
AMBIENTE=oficial
BASE=https://resultados.tse.jus.br
RPS=95                                    # por IP (nunca passa de 100 contra o TSE; o código garante)
INTERVALO_CS=30                           # s entre releituras dos cs.json com seções chegando (2º turno 2026: 10)
HTTP_LOCAL=127.0.0.1:8080                 # difusão (WebSocket/REST) só local; exposição pública é a etapa B

# ------------------------------------------------------------------ painel dos nós (80_painel.sh, docs/PAINEL.md)
# Domínio público (o mesmo do 02_configurar_borda.sh). No cliente OAuth do Google (Aplicativo da Web), cadastre o URI
# de redirecionamento https://<URL_DOMINIO>/painel/oauth/retorno. SEGREDOS: este arquivo está no .gitignore.
URL_DOMINIO=urnavelox.com.br
# M-005: endereço antigo que responde 301 para o URL_DOMINIO, só no nó A (para onde ele aponta). Vazio desliga.
# Sem a linha, vale urnavelox.duckdns.org.
#DOMINIO_ANTIGO=urnavelox.duckdns.org
# Passo 3 do plano de borda (B-026): subdomínio de leitura (resultado e estado, cache de 30 s) atrás da Cloudflare.
# Só preencher depois de o nome estar no DNS apontando para os dois nós (nuvem cinza), e então rodar o
# 02_configurar_borda.sh: o Caddy obtém o certificado. Vazio (ou sem a linha): sem o site.
#DOMINIO_DADOS=dados.urnavelox.com.br
PAINEL_GOOGLE_ID=                         # <id>.apps.googleusercontent.com
PAINEL_GOOGLE_SEGREDO=                    # segredo do cliente OAuth
PAINEL_EMAILS=                            # quem entra no painel (por vírgula)

# ------------------------------------------------------------------ código
REPO=/mnt/d/git/lukeboh/urna-velox-v2     # worktree local da branch da 2.0 (o código vai por git archive, sem GitHub)
REF=HEAD                                  # o que implantar (commit/branch/tag)

# ------------------------------------------------------------------ ensaio remoto (40_ensaio.sh)
UVREAL=/home/dev/uvreal                    # dados locais (WSL): 2024-2t/dados, /config, metricas_2t.csv, oficial, preparo
ENSAIO_ACEL=10                             # 2º turno de 2024 inteiro a 10× (~1 h); 120 para um teste rápido
