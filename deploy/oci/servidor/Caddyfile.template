# Configuração do Caddy para o Urna Velox
# Este arquivo roda em cada nó da OCI (/etc/caddy/Caddyfile).
# Faz a terminação TLS/HTTPS para o domínio, suporte a WebSocket (/ws) e
# balanceia a carga entre o nó local (127.0.0.1:8080) e o nó parceiro ({$PAR_IP}:8080).

{
    admin off
# B-024: no nó A, o IP do visitante que chega pelo Caddy do B vem no X-Forwarded-For (um voto por IP na playlist)
# PROXIES_CONFIAVEIS:inicio
    servers {
        trusted_proxies static __PROXIES_CONFIAVEIS__
    }
# PROXIES_CONFIAVEIS:fim
}

# 0. Endereço antigo (M-005): tudo o que chegar pelo DuckDNS, inclusive /robots.txt e /sitemap.xml, recebe 301
#    (Moved Permanently) para o mesmo caminho no domínio oficial: o Google transfere a indexação. Só no nó para onde o
#    DNS antigo aponta (o A); nos outros o gerar_caddyfile.sh tira o bloco (lá o Caddy nunca obteria o certificado).
#    O Caddy responde o desafio do Let's Encrypt (/.well-known/acme-challenge) antes do redirecionamento.
# DOMINIO_ANTIGO:inicio
__DOMINIO_ANTIGO__ {
    redir https://{$DOMINIO:localhost}{uri} permanent
}
# DOMINIO_ANTIGO:fim

# 0b. Subdomínio de dados (passo 3 do plano de borda; B-026): o modo HTTP da página (WebSocket recusado, consulta a
#     cada ~60 s) lê daqui, atrás da Cloudflare (nuvem laranja só neste nome; o domínio principal fica direto nos nós).
#     Só a leitura do resultado e do estado, com cache de 30 s na borda (de volta a 30 s em 24/10/2026; da 0.8.48 à 0.9.17 foi 120-150 s; o max-age=1/no-cache da origem é trocado);
#     o resto 404, e erro do serviço em JSON com no-store (não fica no cache). Sem DOMINIO_DADOS no nos.env, o
#     gerar_caddyfile.sh tira o bloco (o Caddy não tentaria o certificado de um nome fora do DNS).
# DADOS:inicio
__DOMINIO_DADOS__ {
    log {
        output file /var/log/caddy/urna-velox-dados.log {
            roll_size 20mb
            roll_keep 3
        }
    }
    header X-Content-Type-Options "nosniff"
    @leitura {
        method GET HEAD
        path /api/v1/resultado/* /api/v1/estado
    }
    handle @leitura {
        reverse_proxy 127.0.0.1:8080 {$PAR_IP:127.0.0.1}:8080 {
            lb_policy round_robin
            health_uri /api/v1/estado
            health_interval 5s
            header_down Cache-Control "public, max-age=30, s-maxage=30"
        }
    }
    handle {
        header Content-Type "application/json; charset=utf-8"
        header Cache-Control "public, max-age=300"
        header Access-Control-Allow-Origin "*"
        respond `{"erro":"nao_encontrado"}` 404
    }
    handle_errors 502 503 504 {
        header Cache-Control "no-store"
        header Retry-After "10"
        header Content-Type "application/json; charset=utf-8"
        header Access-Control-Allow-Origin "*"
        respond `{"erro":"servico_indisponivel","tentar_em_s":10}` 503
    }
}
# DADOS:fim

{$DOMINIO:localhost}, www.{$DOMINIO:localhost} {
    log {
        output file /var/log/caddy/urna-velox-acesso.log {
            roll_size 20mb
            roll_keep 5
        }
    }

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # 1. Rota WebSocket (/ws) — apuração em tempo real
    # Balanceia por menor número de conexões (least_conn) e testa a saúde (/api/v1/estado)
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
        path /ws
    }
    handle @websocket {
        reverse_proxy 127.0.0.1:8080 {$PAR_IP:127.0.0.1}:8080 {
            lb_policy least_conn
            health_uri /api/v1/estado
            health_interval 5s
            flush_interval -1
        }
    }

    # 1b. Playlist de replays (uv-playlist.py, só no nó A, 127.0.0.1:8090): página /playlist e API /api/v1/playlist.
    # O IP do visitante (um voto por IP) segue no X-Real-IP. B-024: o domínio aponta para os dois nós, então o Caddy
    # do B leva a playlist ao A (pelo HTTPS público do A: a sub-rede só abre 7700–7701, 8080 e 8095 entre os nós), e o
    # do A confia no B para o IP do visitante (trusted_proxies, acima). Antes o B respondia 503 e a página ficava sem a
    # contagem para a próxima eleição ao vivo e sem o "▶". O gerar_caddyfile.sh deixa só o bloco do papel do nó.
    @playlist path /playlist /playlist/* /api/v1/playlist /api/v1/playlist/*
# PLAYLIST_LOCAL:inicio
    handle @playlist {
        reverse_proxy 127.0.0.1:8090 {
            header_up X-Real-IP {client_ip}
        }
    }
# PLAYLIST_LOCAL:fim
# PLAYLIST_REMOTO:inicio
    handle @playlist {
        reverse_proxy https://__PLAYLIST_NO_A__ {
            header_up Host {$DOMINIO:localhost}
            transport http {
                tls_server_name {$DOMINIO:localhost}
            }
        }
    }
# PLAYLIST_REMOTO:fim

    # 2. Painel dos nós (uv-painel, docs/PAINEL.md): sempre o deste nó (o painel mostra os dois e fala com o do par
    # pela rede privada). Login com o Google; sem sessão, só a página de entrada.
    handle /painel* {
        reverse_proxy 127.0.0.1:8095
    }

    # 3. Comandos que mudam o serviço (POST/PUT/PATCH/DELETE em /api/*, hoje os controles do replay): só com o login do
    # painel (Google). O Caddy pergunta ao uv-painel deste nó; sem sessão válida, 401 e nada chega ao serviço.
    @controle {
        method POST PUT PATCH DELETE
        path /api/*
        # o voto da playlist é público de propósito (uv-playlist.py tem o próprio limite por IP)
        not path /api/v1/playlist /api/v1/playlist/*
    }
    handle @controle {
        forward_auth 127.0.0.1:8095 {
            uri /painel/auth/verificar
            copy_headers X-Uv-Operador
        }
        reverse_proxy 127.0.0.1:8080 {$PAR_IP:127.0.0.1}:8080 {
            lb_policy round_robin
            health_uri /api/v1/estado
            health_interval 5s
        }
    }

    # 4. Rota REST (/api/v1/*) e SPA (/) — balanceamento Round Robin
    handle {
        reverse_proxy 127.0.0.1:8080 {$PAR_IP:127.0.0.1}:8080 {
            lb_policy round_robin
            health_uri /api/v1/estado
            health_interval 5s
        }
    }

    # 5. Serviço fora do ar nos dois nós (troca de eleição do ciclo, partida da noite) — B-008, 0.8.9.
    # Sem isto o Caddy devolve 502/503 vazio e sem Content-Type; com o "nosniff" acima, o navegador do visitante
    # oferecia salvar um arquivo. A página avisa e se recarrega sozinha; a API responde JSON.
    handle_errors 502 503 504 {
        header Cache-Control "no-store"
        header Retry-After "10"
        @api path /api/* /ws
        handle @api {
            header Content-Type "application/json; charset=utf-8"
            respond `{"erro":"servico_indisponivel","tentar_em_s":10}` 503
        }
        handle {
            header Content-Type "text/html; charset=utf-8"
            respond `<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="refresh" content="10"><title>Urna Velox · atualizando</title>
<style>:root{color-scheme:light dark}body{margin:0;min-height:100vh;display:grid;place-items:center;font:16px/1.5 system-ui,sans-serif;background:light-dark(#f4f5f7,#101216);color:light-dark(#1b1e24,#e8eaee)}main{max-width:28rem;padding:1.5rem;text-align:center}h1{font-size:1.4rem;margin:0 0 .5rem}p{margin:.25rem 0;opacity:.8}</style>
</head><body><main><h1>Urna Velox</h1><p>O serviço está sendo atualizado e volta em instantes.</p>
<p>Esta página se recarrega sozinha.</p></main></body></html>` 503
        }
    }
}
